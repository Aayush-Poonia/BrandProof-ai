rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check ownership or membership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Organizations
    match /organisations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Workspaces
    match /workspaces/{workspaceId} {
      allow read, write: if isAuthenticated();
    }

    // Brand Profiles
    match /brandProfiles/{brandId} {
      allow read, write: if isAuthenticated();
    }

    // Brand Guidelines
    match /brandGuidelines/{guidelineId} {
      allow read, write: if isAuthenticated();
    }

    // Approved Facts / Claims Knowledge Base
    match /approvedFacts/{factId} {
      allow read, write: if isAuthenticated();
    }

    // Brand Assets (Logos, Visuals)
    match /brandAssets/{assetId} {
      allow read, write: if isAuthenticated();
    }

    // Content Submissions
    match /contentSubmissions/{submissionId} {
      allow read, write: if isAuthenticated();
    }

    // Analysis Results
    match /analysisResults/{resultId} {
      allow read, write: if isAuthenticated();
    }

    // Review Comments
    match /reviewComments/{commentId} {
      allow read, write: if isAuthenticated();
    }

    // Approval History / Audit Log
    match /approvalHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }

    // Content Revisions
    match /contentRevisions/{revisionId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
